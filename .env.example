# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Supabase direct connection string
# Found in: Supabase → Settings → Database → Connection string → URI
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Password shown to users before they can view the dashboard
DASHBOARD_PASSWORD=your_chosen_password

# ── Daily email digest ────────────────────────────────────────────────────────
# Gmail App Password (NOT your login password).
# Generate one at: https://myaccount.google.com/apppasswords
# Required: 2-Step Verification must be enabled on the Gmail account first.
GMAIL_APP_PASSWORD=your_16_char_app_password

# Sender and recipient for the daily digest email
DIGEST_EMAIL_FROM=democracy680@gmail.com
DIGEST_EMAIL_TO=democracy680@gmail.com

# ── Google Drive PDF upload ───────────────────────────────────────────────────
# Path to the Service Account JSON key file.
# Setup steps:
#   1. console.cloud.google.com → APIs & Services → Enable "Google Drive API"
#   2. IAM & Admin → Service Accounts → Create service account → Add Key → JSON → download
#   3. Open your Drive folder → Share with the service account email (Editor role)
#   4. Copy folder ID from Drive URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account_key.json
GDRIVE_FOLDER_ID=your_google_drive_folder_id
