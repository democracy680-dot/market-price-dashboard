# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Supabase direct connection string
# Found in: Supabase → Settings → Database → Connection string → URI
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Password shown to users before they can view the dashboard
DASHBOARD_PASSWORD=your_chosen_password

# ── Daily email digest ────────────────────────────────────────────────────────
# Gmail App Password (NOT your login password).
# Generate one at: https://myaccount.google.com/apppasswords
# Required: 2-Step Verification must be enabled on the Gmail account first.
GMAIL_APP_PASSWORD=your_16_char_app_password

# Sender and recipient for the daily digest email
DIGEST_EMAIL_FROM=democracy680@gmail.com
DIGEST_EMAIL_TO=democracy680@gmail.com
